# Optional: copy this file to .env to override Docker Compose defaults.
# `docker compose up` works without a .env file using the built-in defaults below.
# NEVER commit .env to version control

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow_user
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (256-bit) for HS256 security
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_chars
